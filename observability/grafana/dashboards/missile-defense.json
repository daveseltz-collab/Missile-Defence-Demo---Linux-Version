{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "All DDS Topics currently registered in the system",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "minWidth": 80 }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dds_topic_presence",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Topics",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Value": true, "__name__": true,
              "guid": true, "owner_guid": true, "dds_guid": true,
              "process_id": true, "name": true, "participant_guid": true,
              "job": true, "instance": true
            },
            "renameByName": {
              "topic_name": "Topic",
              "registered_type_name": "Type",
              "domain_id": "Domain",
              "hostname": "Host"
            },
            "indexByName": { "topic_name": 0, "registered_type_name": 1, "domain_id": 2, "hostname": 3 }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "All active DataWriters and the topics they publish",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "minWidth": 80 }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dds_data_writer_presence",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "DataWriters",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Value": true, "__name__": true,
              "guid": true, "owner_guid": true, "dds_guid": true,
              "process_id": true, "participant_guid": true,
              "registered_type_name": true, "job": true, "instance": true
            },
            "renameByName": {
              "topic_name": "Topic",
              "name": "Entity Path",
              "domain_id": "Domain",
              "hostname": "Host"
            },
            "indexByName": { "topic_name": 0, "name": 1, "hostname": 2, "domain_id": 3 }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "All active DataReaders and the topics they subscribe to",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "minWidth": 80 }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dds_data_reader_presence",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "DataReaders",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Value": true, "__name__": true,
              "guid": true, "owner_guid": true, "dds_guid": true,
              "process_id": true, "participant_guid": true,
              "registered_type_name": true, "job": true, "instance": true
            },
            "renameByName": {
              "topic_name": "Topic",
              "name": "Entity Path",
              "domain_id": "Domain",
              "hostname": "Host"
            },
            "indexByName": { "topic_name": 0, "name": 1, "hostname": 2, "domain_id": 3 }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Writer history cache samples (solid) and reliable unacknowledged samples (dashed). Unack samples are in the send queue waiting for reader acknowledgement.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Samples",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byNamePattern", "options": "Unack:.*" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dds_data_writer_cache_samples * on(guid) group_left(topic_name) dds_data_writer_presence",
          "legendFormat": "Cache: {{topic_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dds_data_writer_reliable_cache_unack_samples * on(guid) group_left(topic_name) dds_data_writer_presence",
          "legendFormat": "Unack: {{topic_name}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Writer Cache – Current Samples",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Number of samples sitting in each reader's receive queue waiting to be taken by the application.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Samples",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dds_data_reader_cache_samples * on(guid) group_left(topic_name) dds_data_reader_presence",
          "legendFormat": "{{topic_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Reader Cache – Current Samples",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Lifetime maximum samples seen in each writer's cache and reliable unack queue.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 19 },
      "id": 6,
      "options": {
        "displayMode": "lcd",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dds_data_writer_cache_samples_peak * on(guid) group_left(topic_name) dds_data_writer_presence",
          "instant": true,
          "legendFormat": "Cache peak: {{topic_name}}",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dds_data_writer_reliable_cache_unack_samples_peak * on(guid) group_left(topic_name) dds_data_writer_presence",
          "instant": true,
          "legendFormat": "Unack peak: {{topic_name}}",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Writer Cache – Peak (High Watermark)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Lifetime maximum samples seen in each reader's receive queue.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 19 },
      "id": 7,
      "options": {
        "displayMode": "lcd",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dds_data_reader_cache_samples_peak * on(guid) group_left(topic_name) dds_data_reader_presence",
          "instant": true,
          "legendFormat": "{{topic_name}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Reader Cache – Peak (High Watermark)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Rate of samples permanently lost. Any non-zero value means data the application will never receive.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "samples/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line", "steps": [{ "color": "red", "value": 0.001 }] }
          },
          "min": 0,
          "unit": "/ s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 26 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(dds_data_reader_sample_lost_total[$__rate_interval]) * on(guid) group_left(topic_name) dds_data_reader_presence",
          "legendFormat": "{{topic_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Sample Loss Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Samples dropped from the reader cache broken down by the reason. Cache Full = resource_limits exceeded; Old Timestamp = DESTINATION_ORDER violation; Content Filter = filtered before delivery; Instance Replaced = instance lifecycle eviction.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "samples",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 26 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(dds_data_reader_cache_replaced_dropped_samples_total[$__rate_interval]) * on(guid) group_left(topic_name) dds_data_reader_presence",
          "legendFormat": "Cache Full (Replaced): {{topic_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(dds_data_reader_cache_samples_dropped_by_instance_replaced_total[$__rate_interval]) * on(guid) group_left(topic_name) dds_data_reader_presence",
          "legendFormat": "Instance Replaced: {{topic_name}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(dds_data_reader_cache_old_source_ts_dropped_samples_total[$__rate_interval]) * on(guid) group_left(topic_name) dds_data_reader_presence",
          "legendFormat": "Old Timestamp: {{topic_name}}",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(dds_data_reader_cache_tolerance_source_ts_dropped_samples_total[$__rate_interval]) * on(guid) group_left(topic_name) dds_data_reader_presence",
          "legendFormat": "Tolerance Timestamp: {{topic_name}}",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(dds_data_reader_cache_content_filter_dropped_samples_total[$__rate_interval]) * on(guid) group_left(topic_name) dds_data_reader_presence",
          "legendFormat": "Content Filter: {{topic_name}}",
          "range": true,
          "refId": "E"
        }
      ],
      "title": "Sample Drops by Reason",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Reader NACKs sent = repair requests issued because samples were missing. Writer NACKs received = repairs the writer was asked to perform. NACKs on their own are normal for reliable QoS; persistent NACKs alongside sample loss indicate repairs are failing.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "NACKs/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "min": 0,
          "unit": "/ s"
        },
        "overrides": [
          {
            "matcher": { "id": "byNamePattern", "options": "Writer NACKs rcvd:.*" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 35 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(dds_data_reader_protocol_sent_nacks_total[$__rate_interval]) * on(guid) group_left(topic_name) dds_data_reader_presence",
          "legendFormat": "Reader NACKs sent: {{topic_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(dds_data_writer_protocol_received_nacks_total[$__rate_interval]) * on(guid) group_left(topic_name) dds_data_writer_presence",
          "legendFormat": "Writer NACKs rcvd: {{topic_name}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Repair Activity (NACKs)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["rti", "connext", "dds"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": ["$__all"] },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(dds_topic_presence, topic_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Topic",
        "multi": true,
        "name": "topic",
        "query": {
          "query": "label_values(dds_topic_presence, topic_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MissileDefense – DDS Observability",
  "uid": "missile-defense-dds",
  "version": 1,
  "weekStart": ""
}
